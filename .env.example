# =============================================================================
# Variables de entorno de Red Social 777
# Lo leen: docker compose (contructor.yml / despliegue.yml) y `dotnet run`
# (Program.cs carga este archivo automáticamente). Está en .gitignore: no lo subas.
# Si cambias algo, vuelve a levantar:  docker compose -f contructor.yml up -d
#
# Plantilla: deja los valores vacíos y completa tus propias credenciales en .env.
# Nunca pongas secretos reales aquí ni los pegues en el chat.
# =============================================================================

# ----- Puertos publicados en el host -----------------------------------------
# 5290 = nginx (balanceador del backend). Es el puerto registrado en los proveedores.
# 5500 = frontend.
BACKEND_PORT=5290
FRONTEND_PORT=5500

# Réplicas del backend detrás de nginx
BACKEND_REPLICAS=3

# ----- URLs públicas (como las ve el NAVEGADOR) --------------------------------
BACKEND_URL=http://localhost:5290
FRONTEND_URL=http://localhost:5500
# Orígenes extra permitidos por CORS, separados por coma (opcional)
CORS_ALLOWED_ORIGINS=

# ----- Imágenes (solo despliegue.yml) ------------------------------------------
# Local: redsocial / redsocial-frontend con PULL_POLICY=never
# Docker Hub: TU_USUARIO/redsocial:1.0 con PULL_POLICY=always
BACKEND_IMAGE=redsocial
FRONTEND_IMAGE=redsocial-frontend
PULL_POLICY=never

# ----- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=RedsocialDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Solo `dotnet run`: dónde está la base. Con el contenedor de compose es
# localhost:5433 (puerto publicado solo en 127.0.0.1).
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432

# ----- OpenIddict -------------------------------------------------------------------
# Contraseña de certificados/signing.pfx y certificados/encryption.pfx
OPENIDDICT_CERT_PASSWORD=

# ----- Google -------------------------------------------------------------------------
# Callback: http://localhost:5290/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- GitHub -------------------------------------------------------------------------
# Callback: http://localhost:5290/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- Dropbox ------------------------------------------------------------------------
# Callback: http://localhost:5290/auth/dropbox/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ----- Figma --------------------------------------------------------------------------
# Callback: http://localhost:5290/auth/figma/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# ----- X (Twitter) ----------------------------------------------------------------------
# Callback: http://localhost:5290/auth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ----- Discord --------------------------------------------------------------------------
# Callback: http://localhost:5290/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ----- Slack ---------------------------------------------------------------------------
# Callback: http://localhost:5290/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ----- TikTok Login Kit (Sandbox) -----------------------------------------------------------
# TikTok NO acepta localhost: necesita una URL HTTPS pública que llegue al backend
# (túnel ngrok/cloudflared apuntando a http://localhost:5290, o tu dominio).
# TIKTOK_REDIRECT_URI debe ser IDÉNTICA a la registrada en TikTok Developers
# (Login Kit -> Web -> Redirect URI), con la barra final:
#   https://<tu-url-https>/auth/tiktok/callback/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
